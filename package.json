{
  "name": "game-launcher",
  "version": "1.0.0",
  "description": "A console-style, gamepad-friendly game library launcher for Windows, built with Electron + TypeScript.",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "typescript": "^5.6.3"
  }
}
